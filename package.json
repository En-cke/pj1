{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "description": "面向对象的 CLI SVG 编辑器",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-plugin-manifests.mjs",
    "cli": "node dist/src/cli.js",
    "test": "vitest run",
    "check": "npm run build && npm test && npm run test:loader && npm run verify",
    "test:loader": "node --test test/plugin-loader.test.mjs",
    "verify": "node scripts/verify-transcripts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10"
  }
}
